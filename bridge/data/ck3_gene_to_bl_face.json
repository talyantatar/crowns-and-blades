{
 "status": "INFERRED draft - verify side by side in game; directions/gains need calibration",
 "ck3_value_decode": {
  "bone_genes": "value byte 0..255 maps linearly into the template min..max of one attribute; signed s = (v-127.5)/127.5 (neutral ~128)",
  "blendshape_genes_gene_bs_": "template *_neg drives bs_*_min, *_pos drives bs_*_max; s = (pos? +1 : -1) * v/255",
  "source": "Crusader Kings III/game/common/genes/01_genes_morph.txt (e.g. gene_head_width head_width_neg/pos, gene_bs_nose_size nose_size_neg/pos)"
 },
 "bl_weight_from_signed": "w = s<0 ? w0*(1+s) : w0 + (1-w0)*s, with dir=-1 flipping s; w0 = default KeyWeight. Prefer runtime w0 = KeyWeights of MBBodyProperties.ProduceNumericKeyWithDefaultValues -> GetParamsFromKey; neutral_w0_xml is the zero-crossing of key_min..key_max (null when 0 is outside the range).",
 "body": {
  "height": "gene_height -> FaceGenerationParams.HeightMultiplier (0..1); traits giant/dwarf push to 1/0",
  "weight": "gene_bs_body_type / fat body (CK3 weight -100..100 stat) -> DynamicBodyProperties.Weight 0..1",
  "build": "gene_bs_body_shape + prowess/strong traits -> DynamicBodyProperties.Build 0..1",
  "age": "CK3 age -> DynamicBodyProperties.Age and FaceGenerationParams.CurrentAge (BL agents under teenager maturity are forced to age 27 in battle, Mission.SpawnAgent)"
 },
 "colors": {
  "skin": "CK3 skin_color (x,y) -> RGB via game/gfx/portraits/skin_palette.dds -> nearest point of bl_skins_human.json skin_color_gradient_points -> CurrentSkinColorOffset = index/(count-1)",
  "hair": "hair_color -> hair_palette.dds -> hair_color_gradient_points -> CurrentHairColorOffset",
  "eye": "eye_color -> eye_palette.dds -> eye_color_gradient_points -> CurrentEyeColorOffset"
 },
 "hair_beard": "CK3 hairstyle/beard accessory gene template name -> BL style_tag (bl_skins_human.json hair_meshes[].tags / beard_meshes[].tags) -> MBBodyProperties.GetHairIndicesByTag / GetFacialIndicesByTag; fall back to culture tag",
